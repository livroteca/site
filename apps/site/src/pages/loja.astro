---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Loja — Livroteca Brincante do Pina">
  <section>
    <div class="container">
      <div class="section__label">Loja</div>
      <h2 class="section__title">Produtos da Livroteca.</h2>
      <p style="max-width: 60ch; margin-top: var(--space-6);">
        Em breve — a loja é um site separado (stack a definir). Cada compra ajuda
        a auto-sustentar o projeto a longo prazo.
      </p>
    </div>
  </section>
</Layout>
