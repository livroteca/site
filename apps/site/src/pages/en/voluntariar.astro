---
import Layout from "../../layouts/Layout.astro";
import VoluntariarForm from "../../components/VoluntariarForm.astro";
import {
  getPaginaByKey,
  paginaEyebrowFor,
  paginaTitleFor,
  paginaLedeFor,
} from "../../lib/content";

const locale = "en" as const;
const pagina = await getPaginaByKey("voluntariar");
const eyebrow = paginaEyebrowFor(pagina, locale) ?? "Volunteer";
const title = paginaTitleFor(pagina, locale) ?? "The Livroteca runs because people show up.";
const lede = paginaLedeFor(pagina, locale) ?? "The Livroteca has no stable paid team. It runs because people show up — to mediate reading, run workshops, organise the library, document with photo or video, teach a skill, translate, communicate. Volunteering can be in person in Bode or remote.";

const tracks = [
  {
    label: "In person in Bode",
    title: "In the space, with the children.",
    items: [
      "Reading mediation and storytelling",
      "Workshops (writing, drawing, music, capoeira, circus, audiovisual)",
      "School support and literacy",
      "Library organisation and support",
      "Help with events and cultural actions (Cine Bode, cleanups, parties)",
    ],
  },
  {
    label: "Remote",
    title: "From wherever you are.",
    items: [
      "Communication and social media",
      "Graphic design and visual identity",
      "Translation (PT ↔ EN, FR, IT, ES)",
      "Tech — website, podcast, video, automations",
      "Fundraising and partnerships (proposal writing, reporting)",
    ],
  },
];
---

<Layout
  title="Volunteer — Livroteca Brincante do Pina"
  description="Volunteer in person in Bode or remotely: reading, workshops, communication, design, translation, tech."
  locale={locale}
>
  <section>
    <div class="container" style="max-width: 880px;">
      <div class="section__label">{eyebrow}</div>
      <h2 class="section__title">{title}</h2>
      <p style="max-width: 62ch; margin-top: var(--space-4); font-size: 1.1rem; line-height: 1.55;">{lede}</p>

      <div class="vol-grid" style="margin-top: var(--space-12);">
        {tracks.map((t) => (
          <div class="vol-card">
            <div class="vol-card__label">{t.label}</div>
            <h3 class="vol-card__title">{t.title}</h3>
            <ul class="vol-card__list">
              {t.items.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <VoluntariarForm locale={locale} />
    </div>
  </section>
</Layout>

<style>
  .vol-grid {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 768px) {
    .vol-grid { grid-template-columns: 1fr 1fr; }
  }
  .vol-card {
    background: var(--cor-superficie);
    border: var(--borda-grossa);
    border-radius: var(--radius-sm);
    padding: var(--space-6);
    box-shadow: var(--sombra-bloco-md);
  }
  body[data-variant="riso"] .vol-card {
    box-shadow:
      4px 4px 0 var(--cor-amarelo),
      -3px -3px 0 var(--cor-vermelho);
  }
  .vol-card__label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cor-vermelho);
    margin-bottom: var(--space-2);
  }
  .vol-card__title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1;
    text-transform: uppercase;
    margin: 0 0 var(--space-4);
  }
  .vol-card__list {
    margin: 0;
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-2);
    font-size: 0.95rem;
    line-height: 1.5;
  }
</style>
