---
import Layout from "../../layouts/Layout.astro";
const locale = "en" as const;
---

<Layout title="Shop — Livroteca Brincante do Pina" locale={locale}>
  <section>
    <div class="container">
      <div class="section__label">Shop</div>
      <h2 class="section__title">Livroteca products.</h2>
      <p style="max-width: 60ch; margin-top: var(--space-6);">
        Coming soon — the shop is a separate site (stack TBD). Each purchase
        helps self-sustain the project in the long term.
      </p>
    </div>
  </section>
</Layout>
