---
import Layout from "../layouts/Layout.astro";
import { getDocumentosTransparencia, titleFor, categoriaLabel, fmtDate } from "../lib/content";

const docs = await getDocumentosTransparencia();
---

<Layout
  title="Transparência — Livroteca Brincante do Pina"
  description="Documentos institucionais da Livroteca: balanços, atas, prestações de contas, estatuto."
>
  <section>
    <div class="container" style="max-width: 880px;">
      <div class="section__label">Transparência</div>
      <h2 class="section__title">Documentos institucionais.</h2>
      <p style="max-width: 60ch; margin-top: var(--space-4); font-size: 1.05rem;">
        A Livroteca opera por dedicação comunitária e doações. Disponibilizamos
        aqui balanços, atas, prestações de contas e o estatuto da associação.
      </p>

      <div class="transp" style="margin-top: var(--space-12);">
        {docs.length === 0 && (
          <p style="color: var(--cor-texto-fraco);">
            Nenhum documento publicado ainda. Voltaremos a esta página em breve.
          </p>
        )}
        {docs.map((d) => (
          <a class="transp__item" href={d.fileUrl} target="_blank" rel="noopener">
            <div class="transp__icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <path d="M14 2v6h6"/>
              </svg>
            </div>
            <div class="transp__body">
              <span class="transp__cat">{categoriaLabel(d.category)}</span>
              <div class="transp__title">{titleFor(d)}</div>
              <div class="transp__date">{fmtDate(d.date)}</div>
            </div>
            <div class="transp__arrow" aria-hidden="true">↓</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .transp {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .transp__item {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: var(--space-4);
    align-items: center;
    background: var(--cor-superficie);
    border: var(--borda-grossa);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--cor-texto);
    box-shadow: var(--sombra-bloco-sm);
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  .transp__item:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--sombra-bloco-md);
    color: var(--cor-texto);
  }
  body[data-variant="riso"] .transp__item {
    box-shadow:
      3px 3px 0 var(--cor-amarelo),
      -2px -2px 0 var(--cor-vermelho);
  }
  body[data-variant="riso"] .transp__item:hover {
    box-shadow:
      5px 5px 0 var(--cor-amarelo),
      -3px -3px 0 var(--cor-vermelho);
  }
  .transp__icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    background: var(--cor-amarelo);
    border: var(--borda-fina);
    border-radius: var(--radius-sm);
    color: var(--cor-preto);
  }
  .transp__cat {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cor-vermelho);
  }
  .transp__title {
    font-weight: 600;
    font-size: 1.05rem;
    margin-top: 2px;
  }
  .transp__date {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cor-texto-fraco);
    margin-top: 4px;
  }
  .transp__arrow {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--cor-texto-fraco);
  }
</style>
