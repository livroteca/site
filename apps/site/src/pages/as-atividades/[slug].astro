---
import Layout from "../../layouts/Layout.astro";
import ArtigoDetail from "../../components/ArtigoDetail.astro";
import { getAllArtigos, getArtigoBySlug, titleFor, excerptFor, coverUrl } from "../../lib/content";

export async function getStaticPaths() {
  const artigos = await getAllArtigos();
  return artigos.map((a) => ({ params: { slug: a.slug } }));
}

const locale = "pt-BR" as const;
const { slug } = Astro.params;
const artigo = await getArtigoBySlug(slug!);
if (!artigo) {
  return Astro.redirect("/as-atividades");
}

const title = titleFor(artigo, locale);
const excerpt = excerptFor(artigo, locale);
const ogImage = coverUrl(artigo.cover, 1200) ?? undefined;
---

<Layout
  title={`${title} — Livroteca`}
  description={excerpt || undefined}
  locale={locale}
  image={ogImage}
  type="article"
  publishedAt={artigo.date}
>
  <ArtigoDetail artigo={artigo} locale={locale} />
</Layout>
