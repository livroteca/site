---
import { getPodcastEpisodes, titleFor } from "../lib/content";
import { useTranslations, type Locale } from "../lib/i18n";

interface Props {
  locale?: Locale;
}

const { locale = "pt-BR" } = Astro.props;
const t = useTranslations(locale);
const pt = t.podcast;

const SHOW_URL =
  "https://tunein.com/podcasts/Arts--Culture-Podcasts/Radio-de-Andada-A-Voz-da-Lama-l-Livroteca-Brincante-do-Pina-p2276168/";

const sanityEpisodes = await getPodcastEpisodes();

type ClientEpisode = {
  num: string;
  title: string;
  subtitle: string;
  audioUrl: string;
  externalUrl: string;
};

const episodes: ClientEpisode[] = sanityEpisodes.length
  ? sanityEpisodes.map((ep) => ({
      num: ep.number != null ? `EP. ${String(ep.number).padStart(2, "0")}` : "EP",
      title: titleFor(ep, locale),
      subtitle: titleFor(ep, locale),
      audioUrl: ep.audioUrl ?? "",
      externalUrl: ep.externalUrl ?? "",
    }))
  : [
      {
        num: "—",
        title: pt.fallback_title,
        subtitle: pt.fallback_subtitle,
        audioUrl: "",
        externalUrl: SHOW_URL,
      },
    ];
---

<div class="player" data-playing="false" id="player">
  <button type="button" class="player__trigger" aria-label={pt.open_label} aria-expanded="false" data-toggle-player>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
      <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
    </svg>
    <span class="player__trigger-label">{pt.title}</span>
  </button>

  <div class="player__panel" role="dialog" aria-label={pt.dialog_label}>
    <div class="player__head">
      <div>
        <div class="player__title">{pt.title}</div>
        <div class="player__subtitle">{pt.subtitle}</div>
      </div>
      <button class="player__close" data-close-player aria-label={pt.close}>×</button>
    </div>

    <div class="player__now">
      <button class="player__play" data-play-pause aria-label={pt.play}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path class="icon-play" d="M8 5v14l11-7z"/>
          <path class="icon-pause" d="M6 5h4v14H6zM14 5h4v14h-4z" style="display:none"/>
        </svg>
      </button>
      <div class="player__now-info">
        <div class="player__now-title" data-now-title>{episodes[0].title}</div>
        <div class="player__now-meta" data-now-meta>{pt.paused}</div>
      </div>
    </div>

    <div class="player__seek">
      <input type="range" min="0" max="100" step="0.1" value="0" data-seek aria-label={pt.seek} disabled />
      <div class="player__times">
        <span data-time-cur>0:00</span>
        <span data-time-dur>0:00</span>
      </div>
    </div>

    <ul class="player__list" role="listbox" aria-label={pt.episodes_label}>
      {episodes.map((ep, i) => (
        <li>
          <button type="button" data-episode={i} aria-current={i === 0 ? "true" : "false"}>
            <span class="ep-num">{ep.num}</span>
            <span class="ep-title">{ep.subtitle}</span>
            {!ep.audioUrl && ep.externalUrl && (
              <span class="ep-ext" aria-hidden="true">↗</span>
            )}
          </button>
        </li>
      ))}
    </ul>

    <audio data-audio preload="none"></audio>
  </div>
</div>

<script
  is:inline
  define:vars={{
    episodes,
    LBL_PLAY: pt.play,
    LBL_PAUSE: pt.pause,
    LBL_PLAYING: pt.playing,
    LBL_PAUSED: pt.paused,
  }}>
  const player = document.getElementById("player");
  const btnToggle = player.querySelector("[data-toggle-player]");
  const btnClose = player.querySelector("[data-close-player]");
  const btnPlay = player.querySelector("[data-play-pause]");
  const audio = player.querySelector("[data-audio]");
  const nowTitle = player.querySelector("[data-now-title]");
  const nowMeta = player.querySelector("[data-now-meta]");
  const iconPlay = player.querySelector(".icon-play");
  const iconPause = player.querySelector(".icon-pause");
  const epButtons = player.querySelectorAll("[data-episode]");
  const seek = player.querySelector("[data-seek]");
  const timeCur = player.querySelector("[data-time-cur]");
  const timeDur = player.querySelector("[data-time-dur]");

  let currentEp = 0;
  let seeking = false;

  function setPlaying(playing) {
    player.dataset.playing = playing ? "true" : "false";
    btnPlay.setAttribute("aria-label", playing ? LBL_PAUSE : LBL_PLAY);
    iconPlay.style.display = playing ? "none" : "";
    iconPause.style.display = playing ? "" : "none";
    nowMeta.textContent = playing ? LBL_PLAYING : LBL_PAUSED;
  }

  function fmt(s) {
    if (!isFinite(s)) return "0:00";
    const m = Math.floor(s / 60);
    const r = Math.floor(s % 60).toString().padStart(2, "0");
    return `${m}:${r}`;
  }

  function selectEpisode(i) {
    currentEp = i;
    const ep = episodes[i];
    nowTitle.textContent = ep.title;
    audio.pause();
    audio.src = ep.audioUrl || "";
    seek.value = 0;
    seek.max = 100;
    seek.disabled = !ep.audioUrl;
    timeCur.textContent = "0:00";
    timeDur.textContent = "0:00";
    epButtons.forEach((b, idx) => b.setAttribute("aria-current", idx === i ? "true" : "false"));
    setPlaying(false);
  }

  function togglePanel(force) {
    const open = force ?? !player.classList.contains("is-open");
    player.classList.toggle("is-open", open);
    btnToggle.setAttribute("aria-expanded", open ? "true" : "false");
  }

  btnToggle.addEventListener("click", () => togglePanel());
  btnClose.addEventListener("click", () => togglePanel(false));

  btnPlay.addEventListener("click", () => {
    const ep = episodes[currentEp];
    if (!ep.audioUrl) {
      if (ep.externalUrl) window.open(ep.externalUrl, "_blank", "noopener");
      return;
    }
    if (audio.paused) audio.play(); else audio.pause();
  });

  audio.addEventListener("play", () => setPlaying(true));
  audio.addEventListener("pause", () => setPlaying(false));
  audio.addEventListener("ended", () => {
    setPlaying(false);
    const next = (currentEp + 1) % episodes.length;
    selectEpisode(next);
    if (episodes[next].audioUrl) audio.play().catch(() => {});
  });
  audio.addEventListener("loadedmetadata", () => {
    seek.max = audio.duration;
    timeDur.textContent = fmt(audio.duration);
  });
  audio.addEventListener("timeupdate", () => {
    if (!seeking) {
      seek.value = audio.currentTime;
      timeCur.textContent = fmt(audio.currentTime);
    }
  });

  seek.addEventListener("input", () => {
    seeking = true;
    timeCur.textContent = fmt(parseFloat(seek.value));
  });
  seek.addEventListener("change", () => {
    audio.currentTime = parseFloat(seek.value);
    seeking = false;
  });

  epButtons.forEach((b) =>
    b.addEventListener("click", () => {
      const i = parseInt(b.dataset.episode, 10);
      const ep = episodes[i];
      if (!ep.audioUrl && ep.externalUrl) {
        window.open(ep.externalUrl, "_blank", "noopener");
        return;
      }
      selectEpisode(i);
      if (ep.audioUrl) audio.play().catch(() => {});
    })
  );

  document.addEventListener("click", (e) => {
    if (!player.contains(e.target)) togglePanel(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") togglePanel(false);
  });

  selectEpisode(0);
</script>

<style>
  .player {
    position: relative;
    font-family: var(--font-corpo);
  }

  .player__trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: transparent;
    border: var(--borda-grossa);
    border-radius: var(--radius-pilula);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cor-preto);
    transition: background 120ms ease, color 120ms ease;
  }
  .player__trigger:hover,
  .player.is-open .player__trigger {
    background: var(--cor-verde);
    color: var(--cor-branco);
    border-color: var(--cor-verde);
  }
  .player__trigger svg { display: block; flex-shrink: 0; }
  .player__trigger-label { display: none; white-space: nowrap; }
  @media (min-width: 1280px) {
    .player__trigger-label { display: inline; }
  }

  .player__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 14px);
    width: 340px;
    max-width: calc(100vw - var(--space-4) * 2);
    background: var(--cor-branco);
    border: var(--borda-grossa);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    box-shadow: 4px 4px 0 var(--cor-verde);
    display: none;
    z-index: 110;
  }
  .player.is-open .player__panel { display: block; }

  .player__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .player__title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--cor-verde);
  }
  .player__subtitle {
    font-family: var(--font-acento);
    font-size: 0.95rem;
    color: var(--cor-texto-fraco);
  }
  .player__close {
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 1.2rem;
    line-height: 1;
    padding: 4px 8px;
    color: var(--cor-texto-fraco);
  }

  .player__now {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--space-3);
    align-items: center;
  }
  .player__play {
    width: 40px; height: 40px;
    border-radius: 999px;
    border: var(--borda-grossa);
    background: var(--cor-verde);
    color: var(--cor-branco);
    cursor: pointer;
    display: grid; place-items: center;
    padding: 0;
  }
  .player__play svg { display: block; }
  .player__now-title {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.25;
  }
  .player__now-meta {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cor-texto-fraco);
    margin-top: 2px;
  }

  .player__seek { margin: var(--space-3) 0; }
  .player__seek input[type="range"] {
    width: 100%;
    display: block;
    accent-color: var(--cor-verde);
    cursor: pointer;
  }
  .player__seek input[type="range"]:disabled { cursor: default; opacity: 0.5; }
  .player__times {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--cor-texto-fraco);
    margin-top: var(--space-1);
  }

  .player__list {
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    gap: var(--space-1);
    max-height: 200px;
    overflow-y: auto;
    border-top: var(--borda-fina);
    padding-top: var(--space-2);
  }
  .player__list button {
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    font: inherit;
    color: var(--cor-texto);
    border-radius: var(--radius-sm);
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-2);
    align-items: center;
  }
  .player__list button:hover { background: var(--cor-papel); }
  .player__list button[aria-current="true"] {
    background: var(--cor-verde);
    color: var(--cor-branco);
  }
  .player__list button[aria-current="true"] .ep-num { color: var(--cor-branco); }
  .player__list .ep-num {
    font-family: var(--font-display);
    font-size: 0.75rem;
    color: var(--cor-verde);
    letter-spacing: 0.04em;
  }
  .player__list .ep-title {
    font-size: 0.9rem;
    line-height: 1.2;
  }
  .ep-ext { opacity: 0.6; font-size: 0.8rem; }
</style>
