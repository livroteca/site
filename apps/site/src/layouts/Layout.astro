---
import "@fontsource/anton/400.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/caveat/500.css";
import "@fontsource/caveat/700.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PodcastPlayer from "../components/PodcastPlayer.astro";
import AjudarFab from "../components/AjudarFab.astro";
import AjudarModal from "../components/AjudarModal.astro";
import TranslationBanner from "../components/TranslationBanner.astro";
import {
  getLocaleFromUrl,
  htmlLang,
  localizePath,
  type Locale,
} from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  translationFallback?: boolean;
  image?: string;
  type?: "website" | "article";
  publishedAt?: string;
  noindex?: boolean;
}

const locale: Locale = Astro.props.locale ?? getLocaleFromUrl(Astro.url);

const SITE_URL = "https://livrotecabrincantedopina.org";
const DEFAULT_OG = "/images/og-default.png";

const defaultTitles: Record<Locale, string> = {
  "pt-BR": "Livroteca Brincante do Pina",
  en: "Livroteca Brincante do Pina",
};

const defaultDescriptions: Record<Locale, string> = {
  "pt-BR": "Cultura, leitura e brincadeira no coração do Bode — Pina, Recife.",
  en: "Culture, reading and play in the heart of Bode — Pina, Recife.",
};

const {
  title = defaultTitles[locale],
  description = defaultDescriptions[locale],
  translationFallback = false,
  image,
  type = "website",
  publishedAt,
  noindex = false,
} = Astro.props;

const path = Astro.url.pathname;
const canonical = new URL(path, SITE_URL).toString();
const ptUrl = new URL(localizePath("pt-BR", path), SITE_URL).toString();
const enUrl = new URL(localizePath("en", path), SITE_URL).toString();
const ogImage = image
  ? image.startsWith("http")
    ? image
    : new URL(image, SITE_URL).toString()
  : new URL(DEFAULT_OG, SITE_URL).toString();
const ogLocale = locale === "en" ? "en_US" : "pt_BR";
const ogLocaleAlt = locale === "en" ? "pt_BR" : "en_US";

const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
const isHome = path === "/" || path === "/en/" || path === "/en";

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "Livroteca Brincante do Pina",
  url: SITE_URL,
  logo: new URL("/images/logolivro.png", SITE_URL).toString(),
  description: defaultDescriptions["pt-BR"],
  foundingDate: "1997",
  founder: { "@type": "Person", name: "Kcal Gomes" },
  location: {
    "@type": "Place",
    name: "Comunidade do Bode",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Comunidade do Bode, Pina",
      addressLocality: "Recife",
      addressRegion: "PE",
      addressCountry: "BR",
    },
  },
  sameAs: [
    "https://www.instagram.com/livrotecabrincantedopina/",
    "https://www.facebook.com/LivrotecaBrincanteDoPina/",
  ],
};
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="alternate" hreflang="pt-BR" href={ptUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={ptUrl} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Livroteca Brincante do Pina" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    {type === "article" && publishedAt && (
      <meta property="article:published_time" content={publishedAt} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" href="/images/logolivro.png" />

    {isHome && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(orgJsonLd)}
      />
    )}

    <script
      src="https://unpkg.com/@lottiefiles/dotlottie-wc@0.6.2/dist/dotlottie-wc.js"
      type="module"
      is:inline></script>

    {cfAnalyticsToken && (
      <script
        defer
        is:inline
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token":"${cfAnalyticsToken}"}`}></script>
    )}

    <ClientRouter />
  </head>
  <body data-variant="riso" data-locale={locale}>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <symbol id="estrelinha" viewBox="-2.5 -2.5 5 5" overflow="visible">
          <path d="M 0,-2 L 0.45,-0.62 L 1.9,-0.62 L 0.73,0.24 L 1.18,1.62 L 0,0.76 L -1.18,1.62 L -0.73,0.24 L -1.9,-0.62 L -0.45,-0.62 Z" fill="currentColor"/>
        </symbol>
      </defs>
    </svg>

    <Header locale={locale} />
    {translationFallback && <TranslationBanner locale={locale} />}
    <main>
      <slot />
    </main>
    <Footer locale={locale} />

    <PodcastPlayer locale={locale} />
    <AjudarFab locale={locale} />
    <AjudarModal locale={locale} />
  </body>
</html>
